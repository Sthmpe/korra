# Firebase project (public web config — safe to expose; reads are gated by
# Firestore security rules). Values below are the Korra PROD project.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=korra-9ab95
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key

# Canonical site origin (used for SEO canonical URLs, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=https://korra.com.ng

# Where iOS + desktop visitors are sent to "open the app" (PWA web apps).
NEXT_PUBLIC_CUSTOMER_WEBAPP=https://app.korra.com.ng
NEXT_PUBLIC_MERCHANT_WEBAPP=https://business.korra.com.ng

# Android Play Store listing (fallback when the app isn't installed).
NEXT_PUBLIC_ANDROID_PLAY_URL=https://play.google.com/store/apps/details?id=com.korra.shop.live

